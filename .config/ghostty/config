# ~/.config/ghostty/config
# Converted from a WezTerm config
# Reload after editing with Ctrl+Shift+,

# ---- Appearance ----
theme = Catppuccin Mocha
font-family = MesloLGS NF
font-size = 13
window-padding-x = 0
window-padding-y = 0

# ---- Behavior ----
confirm-close-surface = false

# ---- Leader (ctrl+a) sequences ----
# Splits
keybind = ctrl+a>-=new_split:down
keybind = ctrl+a>equal=new_split:right
keybind = ctrl+a>z=toggle_split_zoom

# Tabs
keybind = ctrl+a>c=new_tab
keybind = ctrl+a>x=close_surface
keybind = ctrl+a>p=previous_tab
keybind = ctrl+a>n=next_tab

# ---- Fullscreen ----
keybind = f10=toggle_fullscreen

# ---- Move between splits (ctrl+h/j/k/l) ----
keybind = ctrl+h=goto_split:left
keybind = ctrl+j=goto_split:down
keybind = ctrl+k=goto_split:up
keybind = ctrl+l=goto_split:right

# ---- Resize splits (alt+h/j/k/l) ----
keybind = alt+h=resize_split:left,10
keybind = alt+j=resize_split:down,10
keybind = alt+k=resize_split:up,10
keybind = alt+l=resize_split:right,10
